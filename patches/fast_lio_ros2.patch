@@ -0,0 +1,30 @@
+#include "preprocess.h"
+#include <gtest/gtest.h>
+#include <limits>
+
+TEST(VelodyneInput, RetainsSecondsAndSortsValidSixteenRingPoints)
+{
+  Preprocess preprocessing;
+  preprocessing.set(false, VELO16, 0.9, 1);
+  preprocessing.N_SCANS = 16;
+  preprocessing.SCAN_RATE = 10;
+  preprocessing.time_unit = SEC;
+  pcl::PointCloud<velodyne_ros::Point> cloud;
+  for (float time : {0.09f, 0.01f, 0.05f}) {
+    velodyne_ros::Point point{};
+    point.x = 2.0; point.intensity = 20.0; point.time = time; point.ring = 15;
+    cloud.push_back(point);
+  }
+  auto bad = cloud.front();
+  bad.ring = 16; cloud.push_back(bad);
+  bad.ring = 0; bad.x = std::numeric_limits<float>::infinity(); cloud.push_back(bad);
+  bad.x = std::numeric_limits<float>::quiet_NaN(); cloud.push_back(bad);
+  auto msg = std::make_unique<sensor_msgs::msg::PointCloud2>();
+  pcl::toROSMsg(cloud, *msg);
+  PointCloudXYZI::Ptr output(new PointCloudXYZI);
+  preprocessing.process(msg, output);
+  ASSERT_EQ(output->size(), 3u);
+  EXPECT_NEAR(output->points[0].curvature, 10.0, 0.001);
+  EXPECT_NEAR(output->points[1].curvature, 50.0, 0.001);
+  EXPECT_NEAR(output->points[2].curvature, 90.0, 0.001);
+}
