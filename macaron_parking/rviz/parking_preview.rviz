# 경로 확인 모드용 화면: 시작 자세와 목표 자세를 지정하면 저장 지도에 경로를 표시합니다.
Panels:
  - Class: rviz_common/Displays  # 지도·경로 표시 목록 패널
    Name: Displays  # 패널 이름
  - Class: rviz_common/Tool Properties  # 초기·목표 입력 토픽 설정 패널
    Name: Tool Properties  # 패널 이름
  - Class: rviz_common/Views  # 카메라 보기 설정 패널
    Name: Views  # 패널 이름
Visualization Manager:
  Class: ""  # 기본 시각화 관리자
  Enabled: true  # 화면 표시 활성화
  Name: root  # 시각화 관리자 이름
  Global Options:
    Fixed Frame: map  # 모든 지도·경로의 기준 좌표계
    Background Color: 35; 35; 35  # 배경색(R·G·B)
    Frame Rate: 30  # 화면 갱신 주기(Hz)
  Displays:
    - Class: rviz_default_plugins/PointCloud2  # 저장 PCD 지도 표시
      Name: 저장 PCD 지도  # 화면에 보이는 표시 이름
      Enabled: true  # 지도 표시 활성화
      Alpha: 0.65  # 점군 불투명도(0~1)
      Color: 170; 170; 170  # 지도 점 색상(R·G·B)
      Color Transformer: FlatColor  # 점 높이와 무관한 단색 표시
      Position Transformer: XYZ  # XYZ 필드를 점 위치로 사용
      Style: Points  # 개별 점으로 표시
      Size (Pixels): 2  # 화면 점 크기(픽셀)
      Decay Time: 0  # 저장 지도 표시 유지 시간(0: 다음 지도까지 유지)
      Topic:
        Value: /parking/map  # 새 주차 노드가 발행하는 원본 지도 토픽
        Depth: 1  # 보관할 지도 메시지 수
        History Policy: Keep Last  # 최신 지도만 유지
        Reliability Policy: Reliable  # 지도 메시지의 신뢰 전송 사용
        Durability Policy: Transient Local  # 늦게 연결되어도 저장된 지도 수신
    - Class: rviz_default_plugins/Path  # 생성된 주차 경로 표시
      Name: 주차 경로  # 화면에 보이는 표시 이름
      Enabled: true  # 경로 표시 활성화
      Color: 30; 255; 100  # 경로 색상(R·G·B)
      Alpha: 1  # 경로 불투명도(0~1)
      Line Style: Billboards  # 두께가 보이는 선으로 표시
      Line Width: 0.04  # 경로 선 두께(m)
      Buffer Length: 1  # 최신 경로 하나만 표시
      Pose Style: None  # 표본마다 좌표축 표시 생략
      Topic:
        Value: /parking/path  # Hybrid A*가 생성한 경로 토픽
        Depth: 1  # 보관할 경로 메시지 수
        History Policy: Keep Last  # 최신 경로만 유지
        Reliability Policy: Reliable  # 경로 메시지의 신뢰 전송 사용
        Durability Policy: Transient Local  # 늦게 연결되어도 생성된 경로 수신
    - Class: rviz_default_plugins/Marker  # 선택한 시작 자세의 차량 충돌 영역 표시
      Name: 시작 차량 영역  # 화면에 보이는 표시 이름
      Enabled: true  # 차량 사각형 표시 활성화
      Topic:
        Value: /parking/footprint  # 차체와 충돌 여유의 사각형 토픽
        Depth: 1  # 보관할 차량 표시 메시지 수
        History Policy: Keep Last  # 최신 차량 표시만 유지
        Reliability Policy: Reliable  # 차량 표시 메시지의 신뢰 전송 사용
        Durability Policy: Volatile  # 현재 주기의 차량 표시 수신
  Tools:
    - Class: rviz_default_plugins/Interact  # 표시 객체 조작 도구
    - Class: rviz_default_plugins/MoveCamera  # 지도 화면 이동 도구
    - Class: rviz_default_plugins/Select  # 지도 점 선택 도구
    - Class: rviz_default_plugins/SetInitialPose  # 2D Pose Estimate로 시작 위치·차체 방향 지정
      Topic: /initialpose  # 경로 확인 모드의 수동 시작 자세 토픽
    - Class: rviz_default_plugins/SetGoal  # 2D Goal Pose로 목표 위치·차체 방향 지정
      Topic: /goal_pose  # 경로 확인 모드의 목표 자세 토픽
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho  # 위에서 내려다보는 직교 화면
      Name: Current View  # 현재 카메라 보기 이름
      Target Frame: <Fixed Frame>  # 지도 기준으로 카메라 고정
      Angle: 0  # 화면 회전각(rad)
      Scale: 35  # 지도 1m당 화면 크기(픽셀)
      X: 0  # 화면 중심의 지도 X 위치(m)
      Y: 0  # 화면 중심의 지도 Y 위치(m)
      Near Clip Distance: 0.01  # 카메라의 최소 표시 거리(m)
    Saved: ~  # 저장된 추가 카메라 보기 없음
Window Geometry:
  Width: 1200  # RViz 창 너비(픽셀)
  Height: 800  # RViz 창 높이(픽셀)
  Hide Left Dock: false  # 지도·경로 목록 패널 표시
  Hide Right Dock: false  # 도구·카메라 설정 패널 표시
